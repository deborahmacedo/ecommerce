{
  "openapi": "3.1.0",
  "info": {
    "title": "API E-commerce de Artesanato",
    "description": "Controle de produtos e estoque - DIM0517",
    "version": "0.1.0"
  },
  "paths": {
    "/loja/produto": {
      "post": {
        "tags": [
          "Loja"
        ],
        "summary": "Cadastrar Produto",
        "operationId": "cadastrar_produto_loja_produto_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProdutoCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProdutoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/loja/produto/{codigo}/estoque": {
      "get": {
        "tags": [
          "Loja"
        ],
        "summary": "Consultar Estoque",
        "operationId": "consultar_estoque_loja_produto__codigo__estoque_get",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Codigo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstoqueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/loja/produto/{codigo}/entrada": {
      "put": {
        "tags": [
          "Loja"
        ],
        "summary": "Entrada Estoque",
        "operationId": "entrada_estoque_loja_produto__codigo__entrada_put",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Codigo"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimentacaoEstoqueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstoqueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/loja/produto/{codigo}/saida": {
      "put": {
        "tags": [
          "Loja"
        ],
        "summary": "Saida Estoque",
        "operationId": "saida_estoque_loja_produto__codigo__saida_put",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Codigo"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimentacaoEstoqueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstoqueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/loja/venda": {
      "post": {
        "tags": [
          "Loja"
        ],
        "summary": "Realizar Venda",
        "operationId": "realizar_venda_loja_venda_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VendaCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendaResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EstoqueResponse": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "estoque": {
            "type": "integer",
            "title": "Estoque"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "estoque"
        ],
        "title": "EstoqueResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemVendaRequest": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "quantidade": {
            "type": "integer",
            "title": "Quantidade"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "quantidade"
        ],
        "title": "ItemVendaRequest"
      },
      "ItemVendaResponse": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "quantidade": {
            "type": "integer",
            "title": "Quantidade"
          },
          "subtotal": {
            "type": "number",
            "title": "Subtotal"
          },
          "estoque": {
            "type": "integer",
            "title": "Estoque"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "quantidade",
          "subtotal",
          "estoque"
        ],
        "title": "ItemVendaResponse"
      },
      "MovimentacaoEstoqueRequest": {
        "properties": {
          "quantidade": {
            "type": "integer",
            "title": "Quantidade"
          }
        },
        "type": "object",
        "required": [
          "quantidade"
        ],
        "title": "MovimentacaoEstoqueRequest"
      },
      "ProdutoCreateRequest": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "preco": {
            "type": "number",
            "title": "Preco"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "preco"
        ],
        "title": "ProdutoCreateRequest"
      },
      "ProdutoResponse": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "preco": {
            "type": "number",
            "title": "Preco"
          },
          "estoque": {
            "type": "integer",
            "title": "Estoque"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "preco",
          "estoque"
        ],
        "title": "ProdutoResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VendaCreateRequest": {
        "properties": {
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemVendaRequest"
            },
            "type": "array",
            "minItems": 1,
            "title": "Itens"
          }
        },
        "type": "object",
        "required": [
          "itens"
        ],
        "title": "VendaCreateRequest"
      },
      "VendaResponse": {
        "properties": {
          "total": {
            "type": "number",
            "title": "Total"
          },
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemVendaResponse"
            },
            "type": "array",
            "title": "Itens"
          }
        },
        "type": "object",
        "required": [
          "total",
          "itens"
        ],
        "title": "VendaResponse"
      }
    }
  }
}